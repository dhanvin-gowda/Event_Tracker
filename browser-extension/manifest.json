{
  "manifest_version": 3,
  "name": "HextaUI Event Saver",
  "version": "1.0.0",
  "description": "Send event URLs from your browser directly to your HextaUI dashboard.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://odunqfqnjniegkgkielp.supabase.co/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save Event to HextaUI"
  }
}
